(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["Andrews Plots", "Section",
 CellChangeTimes->{{3.9812387384097576`*^9, 
  3.981238739824768*^9}},ExpressionUUID->"83afb51e-6450-604a-b3cd-\
bdfd38570b44"],

Cell[TextData[{
 "For a high-dimensional data point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["x", "1"], ",", 
       SubscriptBox["x", "2"], ",", "...", ",", 
       SubscriptBox["x", "d"]}], "}"}], " ", "in", " ", 
     SuperscriptBox[
      StyleBox["R",
       FontSlant->"Plain"], "d"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "be68dc50-d432-f744-a88a-e6c758be7197"],
 " the Andrews plot defines:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["f", "x"], "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       SubscriptBox["x", "1"], 
       RowBox[{"\[Sqrt]", "2"}]], "+", 
      RowBox[{
       SubscriptBox["x", "2"], 
       RowBox[{"sin", "(", "t", ")"}]}], "+", 
      RowBox[{
       SubscriptBox["x", "3"], 
       RowBox[{"cos", "(", "2", ")"}]}], "+", 
      RowBox[{
       SubscriptBox["x", "4"], 
       RowBox[{"sin", "(", 
        RowBox[{"2", "t"}], ")"}]}], "+", 
      RowBox[{
       SubscriptBox["x", "5"], 
       RowBox[{"cos", "(", 
        RowBox[{"2", "t"}], ")"}]}], "+"}], "..."}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "af234ed0-7f7a-474a-aeed-6a7ed5c5b647"],
 "\nwhich projects the data onto:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"\[Sqrt]", "2"}]], ",", 
     RowBox[{"sin", "(", "t", ")"}], ",", 
     RowBox[{"cos", "(", "t", ")"}], ",", 
     RowBox[{"sin", "(", 
      RowBox[{"2", "t"}], ")"}], ",", 
     RowBox[{"cos", "(", 
      RowBox[{"2", "t"}], ")"}], ",", "..."}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bee73e5b-a638-e646-9b8f-86985fbc9ce4"],
 "). The curve is plotted over the interval -\[Pi] < t < \[Pi]."
}], "Text",
 CellChangeTimes->{{3.9812387562002144`*^9, 
  3.981238928605339*^9}},ExpressionUUID->"de217ace-8256-9a46-9583-\
fde118bbf960"],

Cell[BoxData[
 RowBox[{
  RowBox[{"t", "=", 
   RowBox[{
    RowBox[{"ToExpression", "[", 
     RowBox[{"StringSplit", "/@", 
      RowBox[{
       RowBox[{"ReadList", "[", 
        RowBox[{"\"\<\\\\\\\\wsl$\\\\ubuntu\\\\mnt\\\\hfscr\\\\xyz_128_298K.\
xyz\>\"", ",", "\"\<String\>\""}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"3", ";;"}], "]"}], "]"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.981238428536928*^9, 3.9812384991290073`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"22fa4765-e766-4f40-aec5-6e768f07190e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AndrewsCurve", "[", 
   RowBox[{"row_List", ",", "t_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "row", "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"row", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], "+", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"row", "[", 
         RowBox[{"[", "k", "]"}], "]"}], "*", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"EvenQ", "[", "k", "]"}], ",", 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"k", "/", "2"}], ")"}], " ", "t"}], "]"}], ",", 
          RowBox[{"OddQ", "[", "k", "]"}], ",", 
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"k", "-", "1"}], ")"}], "/", "2"}], ")"}], " ", "t"}], 
           "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "2", ",", "n"}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.98123850769783*^9, 3.98123850769783*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"076b767b-9cf0-7448-b952-0213e58ab7a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AndrewsPlot", "[", 
   RowBox[{"data_", ",", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "t", "}"}], ",", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"AndrewsCurve", "[", 
          RowBox[{
           RowBox[{"data", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"Evaluate", "@", 
       RowBox[{"FilterRules", "[", 
        RowBox[{
         RowBox[{"{", "opts", "}"}], ",", 
         RowBox[{"Options", "[", "Plot", "]"}]}], "]"}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9812385112513847`*^9, 3.9812385112513847`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"978017d0-d2ce-0a41-ae91-370ad33a1798"],

Cell["\<\
This plots the Andrews curve for 6 atoms of 2 different water molecules. The \
atoms that are part of the same water give curves that are similar.\
\>", "Text",
 CellChangeTimes->{{3.981238895882208*^9, 3.9812388988930645`*^9}, {
  3.981238933889681*^9, 
  3.981238956341156*^9}},ExpressionUUID->"05ad454a-c0ac-f74f-b7c3-\
f2b81f79812b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AndrewsPlot", "[", 
  RowBox[{"t", "[", 
   RowBox[{"[", 
    RowBox[{"1", ";;", "6"}], "]"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9812386310030384`*^9, 3.9812386803070717`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"e76fa3a2-a449-9b48-a455-96dc33801828"],

